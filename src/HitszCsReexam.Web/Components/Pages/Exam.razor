@page "/exam"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject QuestionCatalog Catalog
@inject PracticeStore Store
@inject IJSRuntime JS

<PageTitle>模拟考试 · HITSZ CS Reexam</PageTitle>

<div class="exam-page">
    <h1>模拟考试</h1>

    @if (!Store.Loaded)
    {
        <div class="practice-empty">正在准备题库与本机记录…</div>
    }
    else if (!started)
    {
        <section class="exam-intro">
            <p>65 道单选题、20 道判断题，共 150 分，限时 100 分钟。</p>
            <ul>
                <li>试卷从有确定参考答案的题目中随机抽取，题序固定到本次交卷。</li>
                <li>交卷或时间结束后显示成绩和解析；未作答的题计 0 分。</li>
                <li>已作答的错题会加入本机错题本。刷新页面会结束本次考试，请一次完成。</li>
            </ul>
            <button type="button" class="button-primary" @onclick="Start">开始模拟考试</button>
        </section>
    }
    else
    {
        <div class="toolbar exam-dashboard">
            <span>@(submitted ? "成绩" : "剩余时间")：<strong>@(submitted ? $"{earnedScore} / 150 分" : RemainingText)</strong></span>
            <span>已作答：@answers.Count / @paper.Count</span>
            @if (submitted)
            {
                <span>答对：@CorrectCount 题</span>
                <a href="/mistakes">前往错题本</a>
            }
            else
            {
                <button type="button" class="button-primary" @onclick="() => confirmSubmit = true">交卷</button>
            }
        </div>
        @if (confirmSubmit && !submitted)
        {
            <div class="exam-confirm" role="alert">
                <span>还有 @(paper.Count - answers.Count) 道题未作答。确认交卷？</span>
                <button type="button" @onclick="SubmitAsync">确认交卷</button>
                <button type="button" @onclick="() => confirmSubmit = false">继续作答</button>
            </div>
        }
        @if (!Store.StorageAvailable)
        {
            <div class="practice-notice" role="status">浏览器未允许保存本机错题记录；本次成绩仍可在当前页面查看。</div>
        }
        @if (submitted)
        {
            <p class="exam-result-note" role="status">考试已结束。切换选择题、判断题 Tab 可查看对应题目的作答、参考答案和解析。</p>
        }
        <div class="exam-layout">
            <aside class="exam-sidebar" aria-label="题型导航">
                <div class="exam-type-tabs" role="tablist" aria-label="题型选择" aria-orientation="vertical">
                    <button type="button" id="exam-choice-tab" role="tab" class="exam-type-tab @(selectedType == "单项选择" ? "active" : null)" aria-selected="@(selectedType == "单项选择" ? "true" : "false")" aria-controls="exam-question-panel" @onclick='() => SwitchType("单项选择")'>选择题</button>
                    <button type="button" id="exam-judge-tab" role="tab" class="exam-type-tab @(selectedType == "判断" ? "active" : null)" aria-selected="@(selectedType == "判断" ? "true" : "false")" aria-controls="exam-question-panel" @onclick='() => SwitchType("判断")'>判断题</button>
                </div>
            </aside>
            <div class="exam-main">
                <section class="exam-question-group" id="exam-question-panel" role="tabpanel" aria-labelledby="@(selectedType == "判断" ? "exam-judge-tab" : "exam-choice-tab")" @key="selectedType">
                    <h2>@(selectedType == "判断" ? "判断题（20分）" : "单项选择题（130分）")</h2>
                    @foreach (var item in paper.Where(question => question.Type == selectedType).Select((question, index) => (Question: question, Number: index + 1)))
                    {
                        var question = item.Question;
                        var selectedAnswer = answers.GetValueOrDefault(question.Key);
                        <article class="question-card exam-question" @key="question.Key">
                            <div class="exam-question-head">
                                <span class="exam-question-number">@(item.Number).</span>
                                <div class="question-stem markdown-content"><span class="exam-question-score">（@(question.Score)分）</span>@((MarkupString)question.StemHtml)</div>
                            </div>
                            @if (question.ExtraHtml is not null)
                            {
                                <div class="question-extra markdown-content">@((MarkupString)question.ExtraHtml)</div>
                            }
                            @if (question.Multiple)
                            {
                                <ol class="multiple-options">
                                    @foreach (var statement in question.MultipleOptionHtml)
                                    {
                                        <li class="markdown-content">@((MarkupString)statement)</li>
                                    }
                                </ol>
                            }
                            <div class="exam-options" role="group" aria-label="第 @item.Number 题选择答案">
                                @for (var i = 0; i < question.Options.Count; i++)
                                {
                                    var value = question.Type == "判断" ? question.Options[i] : ((char)('A' + i)).ToString();
                                    var optionId = $"exam-{question.Key}-option-{i}";
                                    <div class="@OptionClass(question, value)">
                                        <input type="radio" name="@($"exam-answer-{question.Key}")" id="@optionId" value="@value" checked="@(selectedAnswer == value)" disabled="@submitted" @onchange="() => Choose(question, value)" />
                                        <label for="@optionId">@if (submitted && question.Type != "判断") { <span class="option-label">@value</span> }<span class="markdown-content">@((MarkupString)question.OptionHtml[i])</span><span class="exam-option-check" aria-hidden="true">✔</span></label>
                                    </div>
                                }
                            </div>
                            @if (submitted)
                            {
                                <div class="practice-result">
                                    <strong>@(selectedAnswer is null ? "未作答" : IsCorrect(question, selectedAnswer) ? "答对了" : "答错了")</strong><span>参考答案：@question.Answer?.ToUpperInvariant()</span>
                                    @if (question.ExplainHtml is not null)
                                    {
                                        <div class="question-explanation markdown-content">@((MarkupString)question.ExplainHtml)</div>
                                    }
                                </div>
                            }
                        </article>
                    }
                </section>
                @if (!submitted)
                {
                    <div class="exam-submit-actions">
                        <span>已作答：@answers.Count / @paper.Count</span>
                        <button type="button" class="button-primary" @onclick="RequestSubmit">交卷</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private const int DurationMinutes = 100;
    private readonly List<Question> paper = [];
    private readonly Dictionary<string, string> answers = [];
    private CancellationTokenSource? timerCancellation;
    private DateTimeOffset endsAt;
    private bool started;
    private bool submitted;
    private bool confirmSubmit;
    private int earnedScore;
    private string selectedType = "单项选择";
    private bool renderMathPending;
    private bool scrollToTopPending;

    private int CorrectCount => paper.Count(q => answers.TryGetValue(q.Key, out var answer) && IsCorrect(q, answer));
    private string RemainingText
    {
        get
        {
            var remaining = endsAt - DateTimeOffset.UtcNow;
            if (remaining < TimeSpan.Zero) remaining = TimeSpan.Zero;
            return $"{(int)remaining.TotalMinutes:D2}:{remaining.Seconds:D2}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Store.LoadAsync();
            StateHasChanged();
        }
        if (renderMathPending)
        {
            renderMathPending = false;
            await JS.InvokeVoidAsync("renderQuestionMath");
        }
        if (scrollToTopPending)
        {
            scrollToTopPending = false;
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private void Start()
    {
        paper.Clear();
        paper.AddRange(Catalog.Questions.Where(q => q.Type == "单项选择" && q.CanScore).OrderBy(_ => Random.Shared.Next()).Take(65));
        paper.AddRange(Catalog.Questions.Where(q => q.Type == "判断" && q.CanScore).OrderBy(_ => Random.Shared.Next()).Take(20));
        if (paper.Count != 85) throw new InvalidOperationException("题库中有确定答案的题目不足以组卷。");
        answers.Clear();
        selectedType = "单项选择";
        earnedScore = 0;
        submitted = false;
        started = true;
        renderMathPending = true;
        endsAt = DateTimeOffset.UtcNow.AddMinutes(DurationMinutes);
        timerCancellation = new CancellationTokenSource();
        _ = TickAsync(timerCancellation.Token);
    }

    private async Task TickAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (DateTimeOffset.UtcNow >= endsAt)
                {
                    await InvokeAsync(SubmitAsync);
                    break;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void Choose(Question question, string value)
    {
        if (!submitted) answers[question.Key] = value;
    }

    private void RequestSubmit()
    {
        confirmSubmit = true;
        scrollToTopPending = true;
    }

    private void SwitchType(string type)
    {
        if (selectedType == type) return;
        selectedType = type;
        confirmSubmit = false;
        renderMathPending = true;
        scrollToTopPending = true;
    }

    private async Task SubmitAsync()
    {
        if (submitted) return;
        submitted = true;
        confirmSubmit = false;
        renderMathPending = true;
        scrollToTopPending = true;
        timerCancellation?.Cancel();
        earnedScore = paper.Where(q => answers.TryGetValue(q.Key, out var answer) && IsCorrect(q, answer)).Sum(q => q.Score);
        await Store.RecordManyAsync(paper.Where(q => answers.ContainsKey(q.Key))
            .Select(q => (q, IsCorrect(q, answers[q.Key]))));
        StateHasChanged();
    }

    private string OptionClass(Question question, string value)
    {
        var classes = "exam-option";
        var selectedAnswer = answers.GetValueOrDefault(question.Key);
        if (selectedAnswer == value) classes += " selected";
        if (submitted)
        {
            if (IsCorrect(question, value)) classes += " correct";
            else if (selectedAnswer == value) classes += " incorrect";
        }
        return classes;
    }

    private static bool IsCorrect(Question question, string answer) =>
        string.Equals(question.Answer, answer, StringComparison.OrdinalIgnoreCase);

    public ValueTask DisposeAsync()
    {
        timerCancellation?.Cancel();
        timerCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
}
