@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="HITSZ CS Reexam 首页">
            <span class="brand-symbol">H<span>.</span></span>
            <span class="brand-text"><strong>HITSZ CS</strong><small>REEXAM / 081200</small></span>
        </a>

        <div class="nav-caption">学习空间</div>
        <nav class="side-nav" aria-label="主导航">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item"><span class="nav-icon">⌂</span> 总览</NavLink>
            <NavLink href="/questions" class="nav-item"><span class="nav-icon">▤</span> 题库浏览</NavLink>
            <span class="nav-item unavailable"><span class="nav-icon">◇</span> 随机刷题 <small>即将推出</small></span>
            <span class="nav-item unavailable"><span class="nav-icon">↺</span> 错题本 <small>即将推出</small></span>
            <span class="nav-item unavailable"><span class="nav-icon">◷</span> 模拟考试 <small>即将推出</small></span>
        </nav>

        <div class="sidebar-bottom">
            <div class="side-note"><span class="side-note-dot"></span> 持续整理中</div>
            <p>给每一个认真准备复试的人。</p>
        </div>
    </aside>

    <div class="main-column">
        <header class="topbar">
            <div class="topbar-path">学习空间 <span>/</span> HITSZ · 081200</div>
            <div class="topbar-right"><span class="beta-label">MVP PREVIEW</span><span class="login-pending">GitHub 登录 · 开发中</span></div>
        </header>
        <main class="main-content">@Body</main>
        <footer class="app-footer">HITSZ CS Reexam <span>·</span> 独立整理的复习工具，非学校官方平台</footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    页面出现错误。<a href="." class="reload">重新加载</a>
    <span class="dismiss">×</span>
</div>
