@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="site-name" href="/">HITSZ CS Reexam</a>
        <nav aria-label="主导航">
            <NavLink href="/" Match="NavLinkMatch.All">首页</NavLink>
            <NavLink href="/questions">题库</NavLink>
            <NavLink href="/practice">随机练习</NavLink>
            <NavLink href="/mistakes">错题本</NavLink>
            <NavLink href="/exam">模拟考试</NavLink>
        </nav>
    </header>
    <main class="main-content">@Body</main>
    <footer class="app-footer">独立整理的复习工具，非学校官方平台。 <a href="/report">报告</a></footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    页面出现错误。<a href="." class="reload">重新加载</a>
    <button type="button" class="dismiss" aria-label="关闭错误提示">关闭</button>
</div>
